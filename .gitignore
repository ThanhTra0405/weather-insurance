# ============================================================
# Weather Insurance - Root .gitignore
# ============================================================


# ============================================================
# .NET / ASP.NET Core
# ============================================================

**/bin/
**/obj/
**/out/

*.nuget.cache
*.user
*.userosscache
*.userprefs
*.suo
*.sln.docstates
*.tss

# Visual Studio
.vs/

# JetBrains Rider
.idea/
*.sln.iml

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json


# ============================================================
# .NET Configuration / Secrets
# ============================================================

appsettings.json
appsettings.Development.json
appsettings.*.json
!appsettings.Example.json

.env
.env.*
!.env.example

# Database / local data
*.db
*.sqlite
*.sqlite3


# ============================================================
# .NET Testing / Coverage
# ============================================================

TestResults/
*.coverage
*.coveragexml


# ============================================================
# Node.js / npm / pnpm
# ============================================================

**/node_modules/

# Build output
**/dist/

# pnpm deploy output
**/bundle/


# ============================================================
# Hardhat
# ============================================================

# Compilation artifacts
**/artifacts/

# Hardhat cache
**/cache/

# TypeChain generated files
**/types/

# Coverage
**/coverage/

# Gas snapshots
**/.gas-snapshot

# Snapshot cheatcodes output
**/snapshots/


# ============================================================
# Logs
# ============================================================

*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*